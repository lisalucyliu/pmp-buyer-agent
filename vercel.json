{
  "framework": "vite",
  "devCommand": "vite --port $PORT",
  "functions": {
    "api/agent.js": {
      "supportsCancellation": true
    }
  },
  "crons": [
    {
      "path": "/api/keep-awake",
      "schedule": "17 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
